# Host ports the stack publishes. Copy to `.env` and change any that clash with
# something already running -- a collision makes `docker compose up` fail rather
# than degrade, and 5432 is very often already taken by a local Postgres.
#
# These change only where the stack is reachable from your machine. Services talk
# to each other over the compose network on their internal ports, which never move.
POSTGRES_PORT=5432
BACKEND_PORT=8080
WEB_PORT=3000
MOBILE_PORT=8081
